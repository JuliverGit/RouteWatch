# RouteWatch server settings. Copy this file to ".env" (same folder) and fill in YOUR values.
# ".env" is git-ignored: never commit it, never put real passwords in this example file.

# ---- Database (PostgreSQL) -------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=routewatch
# The account the SERVER uses. Give it only what it needs (see README-DATABASE.md, step 3).
DB_USER=routewatch_app
DB_PASSWORD=change-me

# Optional: a separate OWNER account used only by `npm run db:migrate` and `npm run db:import`
# (it creates the tables and grants the server account its limited rights).
# If you leave these out, DB_USER is used for everything (acceptable for a local demo only).
MIGRATE_DB_USER=routewatch_owner
MIGRATE_DB_PASSWORD=change-me-too

# Optional: one URL instead of the DB_* values above (postgres://user:password@host:5432/dbname)
# DATABASE_URL=

# TLS to the database: off | require | verify-full.  Default: off for localhost, require for any other host.
# Use verify-full (and DB_SSL_CA, the path of your CA certificate) for a hosted database.
# DB_SSL=off
# DB_SSL_CA=
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=10000

# ---- Server (existing options) -----------------------------------------------------------------
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# SESSION_MINUTES=120
# OCCUPANCY_MAX_PER_MINUTE=120   # most passenger-count taps one conductor can send per minute (protects the server from a stuck button or a script)
# NODE_ENV=production
# ALERT_MAX_PER_MINUTE=30        # most service-alert changes (create/edit/publish/resolve) one user can make per minute
# SOCKET_RECHECK_SECONDS=60      # how often live connections are re-checked against the database (an ended session stops receiving)

# ---- Sign-in sessions -------------------------------------------------------------------------
# SESSION_IDLE_MINUTES=30        # a session not used for this long ends (SESSION_MINUTES above is the absolute limit)

# ---- Google sign-in (server only: never put these in the client or in a VITE_ variable) -----------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application).
# The redirect URI must be registered there EXACTLY as written here.
# GOOGLE_CLIENT_ID=<...>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<your client secret>
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ---- Email (verification and password-reset codes) ----------------------------------------------
# Development default: dev-outbox (messages are saved as files in server/data/dev-outbox, nothing is sent; refused in production).
# Real email: MAIL_TRANSPORT=smtp and your provider's settings (needs: npm install --save-exact nodemailer@10.3.1).
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false              # true only for port 465; on 587 STARTTLS is required
# SMTP_USER=<smtp user>
# SMTP_PASSWORD=<smtp password>
# MAIL_FROM=RouteWatch <no-reply@your-domain>
